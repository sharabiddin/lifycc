# Domain configuration
DOMAIN=example.com

# Let's Encrypt configuration
ACME_EMAIL=admin@example.com

# Cloudflare API (optional - for DNS challenge and wildcard certs)
# Leave empty if not using Cloudflare
CF_API_EMAIL=cloudflare@example.com
CF_API_KEY=your_cloudflare_global_api_key

# Traefik dashboard credentials (user:password)
# Generate with: echo $(htpasswd -nb admin your_password) | sed -e s/\\$/\\$\\$/g
TRAEFIK_DASHBOARD_CREDENTIALS=admin:$$2y$$10$$...

# Server deployment (for GitHub Actions)
SERVER_HOST=your.server.ip
SERVER_USER=deploy
SERVER_PASSWORD=your_server_password

# Note: No Docker registry needed - images are built directly on the server