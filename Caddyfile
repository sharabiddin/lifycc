# Local development (no TLS)
:80 {
    # API routes to backend
    handle /api/* {
        reverse_proxy backend:8080
    }

    # Frontend static files
    handle /app.js* {
        reverse_proxy frontend:80
    }

    handle /logo.svg {
        reverse_proxy frontend:80
    }

    handle /ads.txt {
        reverse_proxy frontend:80
    }

    # Frontend root page
    handle / {
        reverse_proxy frontend:80
    }

    # Short codes (everything else) to backend
    handle {
        rewrite * /api/v1{uri}
        reverse_proxy backend:8080
    }

    # Logging
    log {
        output stdout
        format console
    }
}

# Production (with HTTPS)
lify.cc {
    # Automatic HTTPS with Let's Encrypt
    tls admin@lify.cc

    # API routes to backend
    handle /api/* {
        reverse_proxy backend:8080
    }

    # Frontend static files
    handle /app.js* {
        reverse_proxy frontend:80
    }

    handle /logo.svg {
        reverse_proxy frontend:80
    }

    handle /ads.txt {
        reverse_proxy frontend:80
    }

    # Frontend root page
    handle / {
        reverse_proxy frontend:80
    }

    # Short codes (everything else) to backend
    handle {
        rewrite * /api/v1{uri}
        reverse_proxy backend:8080
    }

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    # Compression
    encode gzip

    # Logging
    log {
        output stdout
        format console
    }
}

www.lify.cc {
    redir https://lify.cc{uri} permanent
}